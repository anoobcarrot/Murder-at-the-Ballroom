--- !u!114 &7952787339083956635
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 7140936764507463438}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 83189876d4d389f43b7dd2e925aa112e, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  CurrentIDCounter: 26
  json: "{\"Options\":[{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":12}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":212.333374,\"yPos\":203.000031},\"ID\":2,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Option
    B:\\n\\n\u201CHow would you describe your relationship with Madame Mirage?\u201D\",\"parentUIDs\":[0],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":19}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":1064.9989,\"yPos\":258.3333},\"ID\":3,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Option
    C:\\n\\n\u201CWho do you think had the strongest motive tonight?\u201D\",\"parentUIDs\":[0],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":5}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-320.66626,\"yPos\":203.666687},\"ID\":4,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Option
    A:\\n\\n\u201CWhat were you doing before Madame\u2019s final performance?\u201D\",\"parentUIDs\":[0],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":9}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-1011.33392,\"yPos\":548.9999},\"ID\":6,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Option
    A:\\n\\n\u201CWere you backstage? Did you touch anything?\u201D\",\"parentUIDs\":[5],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":10}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-723.333252,\"yPos\":564.333252},\"ID\":7,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Option
    B: \\n\\n\u201CDid you alter the lighting? The spotlight seemed off.\u201D\",\"parentUIDs\":[5],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":11}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-453.9995,\"yPos\":565.6665},\"ID\":8,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Option
    C: \\n\\n\u201CWhat about Madame\u2019s dressing room? Did you leave anything
    behind?\u201D\",\"parentUIDs\":[5],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":16}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-90.6665039,\"yPos\":578.333252},\"ID\":13,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Option
    A: \\n\\n\u201CYou were like sisters, weren\u2019t you?\u201D\",\"parentUIDs\":[12],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":17}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":165.333374,\"yPos\":577.6665},\"ID\":14,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Option
    B:\\n\\n\u201CI heard you two had a falling out recently. What happened?\u201D\",\"parentUIDs\":[12],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":18}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":427.33313,\"yPos\":573.6665},\"ID\":15,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Option
    C:\\n\\n \u201CDid you want her out of the way?\u201D\",\"parentUIDs\":[12],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":23}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":724.666565,\"yPos\":563.6666},\"ID\":20,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Option
    A:\\n\\n\u201CWhat about Dexter? He seemed off.\u201D\",\"parentUIDs\":[19],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":24}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":1024.66663,\"yPos\":582.999939},\"ID\":21,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Option
    B:\\n\\n\u201CHow about Ginny? Why was he so upset?\u201D\",\"parentUIDs\":[19],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":25}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":1318,\"yPos\":555.6666},\"ID\":22,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Option
    C: \\n\\n\u201CAnd what\u2019s your opinion on Fan-Atic?\u201D\",\"parentUIDs\":[19],\"SpeechUID\":-1}],\"Parameters\":[],\"SpeechNodes\":[{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":2},{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":3},{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":4}],\"EditorInfo\":{\"isRoot\":true,\"xPos\":205,\"yPos\":22},\"ID\":0,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"\u201COh,
    darling, you\u2019re really going to question me? I\u2019m shocked, truly. But
    go ahead, humour me.\u201D\",\"parentUIDs\":[],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Susie
    Side-Eye\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":6},{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":7},{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":8}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-531.333252,\"yPos\":396.000031},\"ID\":5,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"\u201CAh,
    straight to the point. I was making sure everything was perfect, as usual. Someone\u2019s
    got to keep up appearances, even if it\u2019s for a lost cause like Madame Mirage.\u201D\",\"parentUIDs\":[4],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Susie
    Side-Eye\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-1246.66675,\"yPos\":746.6666},\"ID\":9,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"
    (Smirking): \u201CBackstage? Sure, I was there. But I didn\u2019t lay a finger
    on anything. However, I did notice the crown and sash display case looking a
    little too smudgy for my liking. Fingerprints, darling, might tell you who\u2019s
    been poking around.\u201D\",\"parentUIDs\":[6],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Susie
    Side-Eye\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-848.000244,\"yPos\":774.6664},\"ID\":10,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"(Laughing):
    \u201CYou caught that? Bravo. But it wasn\u2019t me, sweetie. Dexter was fiddling
    around with the spotlight control. You might find his prints there if you\u2019re
    looking to play detective.\u201D\",\"parentUIDs\":[7],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Susie
    Side-Eye\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-540.6665,\"yPos\":715.9998},\"ID\":11,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"(Sly)
    \u201CLeave anything? Oh no, I\u2019m not that careless. But Madame liked to
    write herself little reminders. Check her mirror in the bathroom\u2014she might
    have left a message.\u201D\",\"parentUIDs\":[8],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Susie
    Side-Eye\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":13},{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":14},{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":15}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":195.999878,\"yPos\":434.666565},\"ID\":12,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"\u201CWe
    were\u2026 complicated. Two divas, one spotlight. You do the math, darling.\u201D\",\"parentUIDs\":[2],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Susie
    Side-Eye\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-176.66626,\"yPos\":767.999756},\"ID\":16,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"(Sighing):
    \u201COh, more than sisters. I was her mirror, her shadow. But shadows don\u2019t
    kill, darling\u2014they just reflect the truth. If you want to know how close
    we were, check her vanity. I left her a note before the show started. It\u2019s
    still in her makeup bag.\u201D\",\"parentUIDs\":[13],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Susie
    Side-Eye\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[],\"EditorInfo\":{\"isRoot\":false,\"xPos\":88.00012,\"yPos\":762.6664},\"ID\":17,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"(Laughs
    Bitterly): \u201CFalling out? More like I finally stood up. I was tired of being
    her lapdog. Ask the bartender, Max\u2014he saw us arguing. But don\u2019t expect
    a tearful confession from me.\u201D\",\"parentUIDs\":[14],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Susie
    Side-Eye\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[],\"EditorInfo\":{\"isRoot\":false,\"xPos\":383.999878,\"yPos\":761.999756},\"ID\":18,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"(Coldly):
    \u201CI didn\u2019t have to want her gone; she was destroying herself just fine.
    But you know who did want her out of the way? Little Ginny Tonic, always desperate
    for attention. Check the champagne glass\u2014she tampered with something.\u201D\",\"parentUIDs\":[15],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Susie
    Side-Eye\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":20},{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":21},{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":22}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":1064.66663,\"yPos\":404.666565},\"ID\":19,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"\u201CYou
    mean besides me? Everyone, darling. But let\u2019s play this game anyway.\u201D\",\"parentUIDs\":[3],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Susie
    Side-Eye\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[],\"EditorInfo\":{\"isRoot\":false,\"xPos\":695.3334,\"yPos\":762.6667},\"ID\":23,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"(Smirking):
    \u201COff? Try obsessed. Dexter\u2019s love turned sour a long time ago. He left
    a message in her cigarette pack in the smoking room\u2014one last little \u2018drag\u2019
    for old times\u2019 sake. Go have a look.\u201D\",\"parentUIDs\":[20],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Susie
    Side-Eye\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[],\"EditorInfo\":{\"isRoot\":false,\"xPos\":985.3334,\"yPos\":760.6667},\"ID\":24,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"(Dismissively):
    \u201COh, Ginny\u2019s always upset. He wants what he can\u2019t have. He left
    something behind in the bathroom\u2014a pair of earrings, maybe? Find them, and
    you\u2019ll see how close things really got.\u201D\",\"parentUIDs\":[21],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Susie
    Side-Eye\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[],\"EditorInfo\":{\"isRoot\":false,\"xPos\":1331.33325,\"yPos\":753.333252},\"ID\":25,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"(Eye
    Roll): \u201COh, that girl\u2019s just a fan-girl turned freak show. But she\u2019s
    surprisingly good at getting backstage. She left a bouquet of roses there. The
    note inside? Definitely suspicious.\u201D\",\"parentUIDs\":[22],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Susie
    Side-Eye\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0}]}"
