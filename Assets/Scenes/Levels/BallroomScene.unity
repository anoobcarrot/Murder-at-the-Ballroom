  m_Name: 
  m_EditorClassIdentifier: 
  CurrentIDCounter: 25
  json: "{\"Options\":[{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":4}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-1797.5,\"yPos\":245},\"ID\":1,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"You
    must have been thrilled to be here tonight. See anything suspicious?\",\"parentUIDs\":[0],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":11}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-1308.5,\"yPos\":486},\"ID\":2,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"How
    did you feel when Madame Mirage fell?\",\"parentUIDs\":[0],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":18}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-851.5,\"yPos\":247},\"ID\":3,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Were
    you backstage before the show?\",\"parentUIDs\":[0],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":8}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-2442.5,\"yPos\":135},\"ID\":5,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Normal
    drama? Like what?\",\"parentUIDs\":[4],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":9}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-2445.5,\"yPos\":265},\"ID\":6,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"What
    about Dexter? Did you see him?\",\"parentUIDs\":[4],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":10}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-2436.5,\"yPos\":415},\"ID\":7,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Anyone
    else stand out to you tonight?\",\"parentUIDs\":[4],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":15}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-1709.5,\"yPos\":758},\"ID\":12,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Did
    you notice anything unusual about her performance?\",\"parentUIDs\":[11],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":16}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-1334.5,\"yPos\":804},\"ID\":13,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"You
    seemed really invested in her every move. Why?\",\"parentUIDs\":[11],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":17}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-1026.5,\"yPos\":742},\"ID\":14,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Were
    you close enough to hear anything she said?\",\"parentUIDs\":[11],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":22}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-145.5,\"yPos\":62},\"ID\":19,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"What
    did you see Susie do backstage?\",\"parentUIDs\":[18],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":23}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-166.5,\"yPos\":244},\"ID\":20,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"What
    did you say to Madame Mirage before the show?\",\"parentUIDs\":[18],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":24}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-154.5,\"yPos\":434},\"ID\":21,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Did
    you see Ginny or Dexter backstage too?\",\"parentUIDs\":[18],\"SpeechUID\":-1}],\"Parameters\":[],\"SpeechNodes\":[{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":1},{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":2},{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":3}],\"EditorInfo\":{\"isRoot\":true,\"xPos\":-1301,\"yPos\":237},\"ID\":0,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Eeeeeee,
    I've waited my whole life to be asked about Madam Mirage!\",\"parentUIDs\":[],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Fan
    Atic\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":5},{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":6},{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":7}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-2158.5,\"yPos\":231},\"ID\":4,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Oh
    my gosh, yesss! It was the BEST night... until it wasn\u2019t. But I didn\u2019t
    see anything bad. Just... everyone\u2019s normal drama.\",\"parentUIDs\":[1],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Fan
    Atic\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-2711.5,\"yPos\":107},\"ID\":8,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Oh,
    you know. Like Susie arguing with Ginny. But I thought they were just being...
    you know, sisters. But Susie looked like she wanted to... I dunno, do something
    bad. Maybe ask another audience member fof insights? Everyone enjoys their fabulous
    drama.\",\"parentUIDs\":[5],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Fan
    Atic\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-2707.5,\"yPos\":263},\"ID\":9,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Dexter
    was all over the place. He even dropped his wig cap near the stage. But nobody
    noticed, and he was gone before anyone could pick it up. Maybe he was hiding
    something.\",\"parentUIDs\":[6],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Fan
    Atic\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-2712.5,\"yPos\":412},\"ID\":10,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Yeah,
    Ginny seemed really... jumpy. And he left the bathroom in such a rush. You should
    check if there\u2019s anything left behind there.\",\"parentUIDs\":[7],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Fan
    Atic\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":12},{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":13},{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":14}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-1305.5,\"yPos\":626},\"ID\":11,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Feel?
    I... I felt... lost. Like someone took my whole world and just... crushed it.
    But maybe she wanted it that way\u2014wanted to go out in a blaze of glory.\",\"parentUIDs\":[2],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Fan
    Atic\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-1775.5,\"yPos\":937},\"ID\":15,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"She
    looked... like something was on her mind.  Maybe ask Big Daddy Blaze? Mirage
    would confine in him during pre show smoke breaks.\",\"parentUIDs\":[12],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Fan
    Atic\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-1335.5,\"yPos\":949},\"ID\":16,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Oh,
    I am! I know everything about her\u2014every performance, every costume change,
    even her favourite makeup brand. Sometimes, when I watch closely enough, I can
    see what she\u2019s thinking. But tonight, she looked... worried. Check her makeup
    bag. It might be there\u2014something\u2019s off.\",\"parentUIDs\":[13],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Fan
    Atic\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-982.5,\"yPos\":914},\"ID\":17,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"I
    was! I was right by the front. She whispered something... but I couldn\u2019t
    catch it all. It was something about \u2018time running out\u2019 and... I think
    she said \u2018lighting.\u2019 Maybe check the control panel backstage?\",\"parentUIDs\":[14],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Fan
    Atic\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":19},{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":20},{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":21}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-421.5,\"yPos\":232},\"ID\":18,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"M-maybe...
    I mean, I was only there for a second! Just to wish her luck! But then... then
    Susie came over, and I left. I didn\u2019t want to get in her way.\",\"parentUIDs\":[3],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Fan
    Atic\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[],\"EditorInfo\":{\"isRoot\":false,\"xPos\":155.5,\"yPos\":43},\"ID\":22,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"She
    was... near the lighting controls. I thought she was just fixing something, but
    she looked... sneaky. Maybe ask another participant - they might have seen more
    backstage?\_\",\"parentUIDs\":[19],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Fan
    Atic\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[],\"EditorInfo\":{\"isRoot\":false,\"xPos\":141.5,\"yPos\":228},\"ID\":23,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"I\u2014I
    wished her luck. Told her I\u2019d always be her biggest fan, no matter what.
    But she just... brushed me off. Said I should... \u2018step back and let the
    real stars shine.\u2019 So, I left her the bouquet. Maybe it\u2019s still there.
    Maybe you\u2019ll find something I missed.\\n\",\"parentUIDs\":[20],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Fan
    Atic\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[],\"EditorInfo\":{\"isRoot\":false,\"xPos\":158.5,\"yPos\":408},\"ID\":24,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"I
    did! Dexter was arguing with Madame by the dressing room door, but he stormed
    off before I could get close. Ginny... well, he just looked lost. He kept staring
    at the lipstick on the mirror. I thought it was just nerves, but now... who knows?\",\"parentUIDs\":[21],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Fan
    Atic\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0}]}"
