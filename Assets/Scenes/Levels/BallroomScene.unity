  m_Name: 
  m_EditorClassIdentifier: 
  CurrentIDCounter: 17
  json: "{\"Options\":[{\"Connections\":[],\"EditorInfo\":{\"isRoot\":false,\"xPos\":31.999939,\"yPos\":208.333328},\"ID\":6,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Player
    option A: \u201CWhat were you doing before Madame\u2019s final performance?\u201D\",\"parentUIDs\":[0],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":9}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":259.333252,\"yPos\":201.66658},\"ID\":7,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Player
    Choice B: \u201CHow would you describe your relationship with Madame Mirage?\u201D\",\"parentUIDs\":[0],\"SpeechUID\":-1},{\"Connections\":[],\"EditorInfo\":{\"isRoot\":false,\"xPos\":469.3333,\"yPos\":200.3332},\"ID\":8,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Player
    Choice C: \u201CWho do you think had the strongest motive tonight?\u201D\",\"parentUIDs\":[0],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":14}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":9.333282,\"yPos\":522.333252},\"ID\":11,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Player
    Choice B1: \u201CYou were like sisters, weren\u2019t you?\u201D\",\"parentUIDs\":[9],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":15}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":263.333252,\"yPos\":529.6666},\"ID\":12,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Player
    Choice B2: \u201CI heard you two had a falling out recently. What happened?\u201D\",\"parentUIDs\":[9],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":16}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":507.999817,\"yPos\":528.9999},\"ID\":13,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Player
    Choice B3: \u201CDid you want her out of the way?\u201D\",\"parentUIDs\":[9],\"SpeechUID\":-1}],\"Parameters\":[],\"SpeechNodes\":[{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":6},{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":7},{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":8}],\"EditorInfo\":{\"isRoot\":true,\"xPos\":167.333313,\"yPos\":22},\"ID\":0,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Susie:
    \u201COh, darling, you\u2019re really going to question me? I\u2019m shocked,
    truly. But go ahead, humour me.\u201D\",\"parentUIDs\":[],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Susie
    Side Eye\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":11},{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":12},{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":13}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":249.999939,\"yPos\":361.3333},\"ID\":9,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Susie\u2019s
    Response: \u201CWe were\u2026 complicated. Two divas, one spotlight. You do the
    math, darling.\u201D\",\"parentUIDs\":[7],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Susie
    Side Eye\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-15.3333893,\"yPos\":677.9999},\"ID\":14,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Susie\u2019s
    Response B1\_(Sighing): \u201COh, more than sisters. I was her mirror, her shadow.
    But shadows don\u2019t kill, darling\u2014they just reflect the truth. If you
    want to know how close we were, check her vanity. I left her a note before the
    show started. It\u2019s still in her makeup bag.\u201D\",\"parentUIDs\":[11],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Susie
    Side Eye\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[],\"EditorInfo\":{\"isRoot\":false,\"xPos\":268.6666,\"yPos\":677.333252},\"ID\":15,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Susie\u2019s
    Response B2 (Laughs Bitterly): \u201CFalling out? More like I finally stood up.
    I was tired of being her lapdog. Ask the bartender, Max\u2014he saw us arguing.
    But don\u2019t expect a tearful confession from me.\u201D\",\"parentUIDs\":[12],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Susie
    Side Eye\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[],\"EditorInfo\":{\"isRoot\":false,\"xPos\":524.6666,\"yPos\":675.333252},\"ID\":16,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Susie\u2019s
    Response B3 (Coldly): \u201CI didn\u2019t have to want her gone; she was destroying
    herself just fine. But you know who did want her out of the way? Little Ginny
    Tonic, always desperate for attention. Check the champagne glass\u2014she tampered
    with something.\u201D\",\"parentUIDs\":[13],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Susie
    Side Eye\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0}]}"
