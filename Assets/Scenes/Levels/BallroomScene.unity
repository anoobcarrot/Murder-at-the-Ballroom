  CurrentIDCounter: 25
  json: "{\"Options\":[{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":4}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-881.501,\"yPos\":-26.0000153},\"ID\":1,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Were
    you backstage before the show?\",\"parentUIDs\":[0],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":11}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-646.099854,\"yPos\":-23.4002228},\"ID\":2,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Did
    you see anything unusual?\",\"parentUIDs\":[0],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":18}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-401.100281,\"yPos\":-23.2001343},\"ID\":3,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"What
    did Madame Mirage say to you?\",\"parentUIDs\":[0],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":8}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-1879.29968,\"yPos\":468.800171},\"ID\":5,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"What
    did you see?\",\"parentUIDs\":[4],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":9}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-1573.50159,\"yPos\":464.4004},\"ID\":6,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Did
    you talk to Madame?\",\"parentUIDs\":[4],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":10}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-1316.50281,\"yPos\":468.8003},\"ID\":7,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Did
    you see Dexter there?\",\"parentUIDs\":[4],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":15}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-914.3015,\"yPos\":380.6006},\"ID\":12,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"What
    about the lighting controls?\",\"parentUIDs\":[11],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":16}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-652.9005,\"yPos\":383.4005},\"ID\":13,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"What
    about the judges\u2019 table?\",\"parentUIDs\":[11],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":17}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-388.100769,\"yPos\":383.0005},\"ID\":14,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"What
    else caught your eye?\",\"parentUIDs\":[11],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":22}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":636.900146,\"yPos\":380.600342},\"ID\":19,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Did
    she mention anyone specifically?\",\"parentUIDs\":[18],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":23}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":331.098328,\"yPos\":385.000244},\"ID\":20,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"What
    else did she mention?\",\"parentUIDs\":[18],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":24}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":39.0991821,\"yPos\":386.200439},\"ID\":21,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Did
    she seem worried?\",\"parentUIDs\":[18],\"SpeechUID\":-1}],\"Parameters\":[],\"SpeechNodes\":[{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":1},{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":2},{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":3}],\"EditorInfo\":{\"isRoot\":true,\"xPos\":-657.8004,\"yPos\":-287.600037},\"ID\":0,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"\\\"Give
    me that mic! I've waited my whole life for this moment.\\\"\",\"parentUIDs\":[],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Fan
    Atic\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":5},{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":6},{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":7}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-1578.49915,\"yPos\":226.400116},\"ID\":4,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"\\\"I
    was... I live for the devil in everyones behind the curtain details.\\\"\",\"parentUIDs\":[1],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Fan
    Atic\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-1887.49988,\"yPos\":563.9994},\"ID\":8,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"(Hesitant)
    \u201CSusie was near the lighting controls. She looked sneaky.\u201D\",\"parentUIDs\":[5],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Fan
    Atic\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-1573.90247,\"yPos\":560.799561},\"ID\":9,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"
    (Sighs) \u201CYes, but she brushed me off. I left her the bouquet.\u201D\",\"parentUIDs\":[6],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Fan
    Atic\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-1311.70349,\"yPos\":558.5995},\"ID\":10,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"(Excitedly)
    \u201CYes! He seemed flustered and dropped something. I didn\u2019t get a good
    look.\u201D\",\"parentUIDs\":[7],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Fan
    Atic\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":12},{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":13},{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":14}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-651.9005,\"yPos\":211.799591},\"ID\":11,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Unusual?!
    Someone took my whole world and just... crushed it. But maybe she wanted it that
    way\u2014wanted to go out in a blaze of glory.\",\"parentUIDs\":[2],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Fan
    Atic\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-909.9011,\"yPos\":479.60083},\"ID\":15,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"(Nods)
    \u201CI saw someone fiddling with them, but I didn\u2019t stick around.\u201D\",\"parentUIDs\":[12],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Fan
    Atic\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-652.300537,\"yPos\":474.0005},\"ID\":16,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"(Giggling)
    \u201COh, it looked like someone was messing with the glasses, but I don\u2019t
    know who!\u201D\",\"parentUIDs\":[13],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Fan
    Atic\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-387.300476,\"yPos\":479.000854},\"ID\":17,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"(Excitedly)
    \u201CThe crown and sash\u2014they were so shiny! But someone opened the case...
    I saw the smudge!\u201D\",\"parentUIDs\":[14],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Fan
    Atic\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":19},{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":20},{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":21}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":191.30011,\"yPos\":155.399963},\"ID\":18,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"It
    was but a moment. I went to wish her luck! But then... then Susie came over,
    and I left. I didn\u2019t want to get in her way.\",\"parentUIDs\":[3],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Fan
    Atic\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[],\"EditorInfo\":{\"isRoot\":false,\"xPos\":640.299561,\"yPos\":471.2002},\"ID\":22,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"(Pausing)
    \u201CMaybe Susie... she said something like, \u2018She\u2019s always watching.\u2019\u201D\",\"parentUIDs\":[19],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Fan
    Atic\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[],\"EditorInfo\":{\"isRoot\":false,\"xPos\":334.297974,\"yPos\":470.6001},\"ID\":23,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"(Nervous)
    \u201CShe told me to \u2018stay in my lane.\u2019 I think she was stressed.\u201D\",\"parentUIDs\":[20],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Fan
    Atic\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[],\"EditorInfo\":{\"isRoot\":false,\"xPos\":40.8985,\"yPos\":469.000366},\"ID\":24,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"(Softly)
    \u201CYes. She said something about \u2018time running out.\u2019 It sounded
    important.\u201D\",\"parentUIDs\":[21],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Fan
    Atic\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0}]}"
