  m_Name: 
  m_EditorClassIdentifier: 
  CurrentIDCounter: 25
  json: "{\"Options\":[{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":4}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":117.600464,\"yPos\":-325.3999},\"ID\":1,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"What
    were you doing before Madame\u2019s final performance?\",\"parentUIDs\":[0],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":5}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":416.000244,\"yPos\":-311.799866},\"ID\":2,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"How
    would you describe your relationship with Madame Mirage?\",\"parentUIDs\":[0],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":6}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":666.199463,\"yPos\":-305.999878},\"ID\":3,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Who
    do you think had the strongest motive tonight?\",\"parentUIDs\":[0],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":10}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-660.7998,\"yPos\":89.80017},\"ID\":7,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Were
    you backstage? Did you touch anything?\",\"parentUIDs\":[4],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":11}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-354.400146,\"yPos\":92.4000244},\"ID\":8,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Did
    you alter the lighting? The spotlight seemed off.\",\"parentUIDs\":[4],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":12}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-59.19934,\"yPos\":85.80005},\"ID\":9,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"What
    about Madame\u2019s dressing room? Did you leave anything behind?\",\"parentUIDs\":[4],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":16}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":160.8009,\"yPos\":51.39978},\"ID\":13,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"You
    were like sisters, weren\u2019t you?\",\"parentUIDs\":[5],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":17}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":315.200684,\"yPos\":144.200134},\"ID\":14,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"I
    heard you two had a falling out recently. What happened?\",\"parentUIDs\":[5],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":18}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":482.400146,\"yPos\":52.19983},\"ID\":15,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Did
    you want her out of the way?\",\"parentUIDs\":[5],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":22}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":886.9988,\"yPos\":54.5999756},\"ID\":19,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"What
    about Dexter? He seemed off.\",\"parentUIDs\":[6],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":23}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":1142.39966,\"yPos\":53},\"ID\":20,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"How
    about Ginny? Why was he so upset?\",\"parentUIDs\":[6],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":24}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":1381.2002,\"yPos\":51.3999023},\"ID\":21,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"And
    what\u2019s your opinion on Fan-Atic?\",\"parentUIDs\":[6],\"SpeechUID\":-1}],\"Parameters\":[],\"SpeechNodes\":[{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":1},{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":2},{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":3}],\"EditorInfo\":{\"isRoot\":true,\"xPos\":428,\"yPos\":-452},\"ID\":0,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Oh,
    darling, you\u2019re really going to question me? I\u2019m shocked, truly. But
    go ahead, humour me.\",\"parentUIDs\":[],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Susie
    Side Eye\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":7},{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":8},{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":9}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-55.99939,\"yPos\":-155.599915},\"ID\":4,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Ah,
    straight to the point. I was making sure everything was perfect, as usual. Someone\u2019s
    got to keep up appearances, even if it\u2019s for a lost cause like Madame Mirage.\",\"parentUIDs\":[1],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Susie
    Side Eye\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":13},{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":14},{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":15}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":322.400635,\"yPos\":-107.599915},\"ID\":5,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"We
    were\u2026 complicated. Two divas, one spotlight. You do the math, darling.\",\"parentUIDs\":[2],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Susie
    Side Eye\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":19},{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":20},{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":21}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":912.7993,\"yPos\":-130.799927},\"ID\":6,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"You
    mean besides me? Everyone, darling. But let\u2019s play this game anyway.\",\"parentUIDs\":[3],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Susie
    Side Eye\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-765.600342,\"yPos\":239.60022},\"ID\":10,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Backstage?
    Sure, I was there. But I didn\u2019t lay a finger on anything. However, I did
    notice the crown and sash display case looking a little too smudgy for my liking.
    Fingerprints, darling, might tell you who\u2019s been poking around.\",\"parentUIDs\":[7],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Susie
    Side Eye\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-413.6001,\"yPos\":255.600342},\"ID\":11,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"You
    caught that? Bravo. But it wasn\u2019t me, sweetie. Dexter was fiddling around
    with the spotlight control. You might find his prints there if you\u2019re looking
    to play detective.\",\"parentUIDs\":[8],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Susie
    Side Eye\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-76.79944,\"yPos\":266.200317},\"ID\":12,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Leave
    anything? Oh no, I\u2019m not that careless. But Madame liked to write herself
    little reminders. Check her mirror in the bathroom\u2014she might have left a
    message.\",\"parentUIDs\":[9],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Susie
    Side Eye\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[],\"EditorInfo\":{\"isRoot\":false,\"xPos\":113.000854,\"yPos\":401.200928},\"ID\":16,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Oh,
    more than sisters. I was her mirror, her shadow. But shadows don\u2019t kill,
    darling\u2014they just reflect the truth. If you want to know how close we were,
    check her vanity. I left her a note before the show started. It\u2019s still
    in her makeup bag.\",\"parentUIDs\":[13],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Susie
    Side Eye\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[],\"EditorInfo\":{\"isRoot\":false,\"xPos\":284.800537,\"yPos\":505.201538},\"ID\":17,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Falling
    out? More like I finally stood up. I was tired of being her lapdog. Ask the bartender,
    Max\u2014he saw us arguing. But don\u2019t expect a tearful confession from me.\",\"parentUIDs\":[14],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Susie
    Side Eye\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[],\"EditorInfo\":{\"isRoot\":false,\"xPos\":507.2002,\"yPos\":302.800659},\"ID\":18,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"I
    didn\u2019t have to want her gone; she was destroying herself just fine. But
    you know who did want her out of the way? Little Ginny Tonic, always desperate
    for attention. Check the champagne glass\u2014she tampered with something.\",\"parentUIDs\":[15],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Susie
    Side Eye\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[],\"EditorInfo\":{\"isRoot\":false,\"xPos\":841.199463,\"yPos\":209.600342},\"ID\":22,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Off?
    Try obsessed. Dexter\u2019s love turned sour a long time ago. He left a message
    in her cigarette pack in the smoking room\u2014one last little \u2018drag\u2019
    for old times\u2019 sake. Go have a look.\",\"parentUIDs\":[19],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Susie
    Side Eye\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[],\"EditorInfo\":{\"isRoot\":false,\"xPos\":1108.7998,\"yPos\":210.000366},\"ID\":23,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Oh,
    Ginny\u2019s always upset. He wants what he can\u2019t have. He left something
    behind in the bathroom\u2014a pair of earrings, maybe? Find them, and you\u2019ll
    see how close things really got.\",\"parentUIDs\":[20],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Susie
    Side Eye\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[],\"EditorInfo\":{\"isRoot\":false,\"xPos\":1441.6001,\"yPos\":213.200317},\"ID\":24,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Oh,
    that girl\u2019s just a fan-girl turned freak show. But she\u2019s surprisingly
    good at getting backstage. She left a bouquet of roses there. The note inside?
    Definitely suspicious.\",\"parentUIDs\":[21],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Susie
    Side Eye\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0}]}"
