--- !u!114 &1082600865
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1082600861}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 83189876d4d389f43b7dd2e925aa112e, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  CurrentIDCounter: 25
  json: "{\"Options\":[{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":4}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-431.5,\"yPos\":46},\"ID\":1,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Option
    A:\\n\u201CWhat was your relationship with Madame Mirage like?\u201D\",\"parentUIDs\":[0],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":11}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-4.5,\"yPos\":280},\"ID\":2,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Option
    B:\\n\u201CWere you jealous when she ended things?\u201D\",\"parentUIDs\":[0],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":18}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":595.5,\"yPos\":20},\"ID\":3,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Option
    C: \\n\u201CWhere were you before Madame\u2019s final performance?\",\"parentUIDs\":[0],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":8}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-1313.5,\"yPos\":-24},\"ID\":5,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Option
    A: \\n\u201CDid you ever want her out of the way?\u201D\",\"parentUIDs\":[4],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":9}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-1304.5,\"yPos\":120},\"ID\":6,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Option
    B:\\n\u201CDid you two argue tonight? Someone heard you.\u201D\",\"parentUIDs\":[4],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":10}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-1291.5,\"yPos\":260},\"ID\":7,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Option
    C:\\n\u201CWas it just jealousy, or something more?\u201D\",\"parentUIDs\":[4],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":15}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-385.5,\"yPos\":644},\"ID\":12,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Option
    A:\\n\u201CDid you try to get her back tonight?\u201D\",\"parentUIDs\":[11],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":16}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-15.5,\"yPos\":662},\"ID\":13,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Option
    B:\\n\u201CWhat did you do when she rejected you?\u201D\",\"parentUIDs\":[11],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":17}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":338.5,\"yPos\":639},\"ID\":14,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Option
    C:\\n\u201CDid you want revenge?\u201D\",\"parentUIDs\":[11],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":22}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":1326.5,\"yPos\":-139},\"ID\":19,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Option
    A:\\n\u201CDid you see anyone else backstage before the show started?\u201D\",\"parentUIDs\":[18],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":23}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":1323.5,\"yPos\":18},\"ID\":20,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Option
    B: \\n\u201CYour name came up around the lighting controls. What were you doing
    there?\u201D\",\"parentUIDs\":[18],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":24}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":1309.5,\"yPos\":177},\"ID\":21,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Option
    C:\\n\u201CAnyone see you around that time? You have an alibi?\u201D\",\"parentUIDs\":[18],\"SpeechUID\":-1}],\"Parameters\":[],\"SpeechNodes\":[{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":1},{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":2},{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":3}],\"EditorInfo\":{\"isRoot\":true,\"xPos\":10.5,\"yPos\":22},\"ID\":0,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"\\\"Well
    well well, look what the cat dragged in.\\\"\",\"parentUIDs\":[],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Dexter
    Delight\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":5},{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":6},{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":7}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-862.5,\"yPos\":34},\"ID\":4,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"\u201CWe
    were fire and ice, passion and pain. It was toxic\u2014beautifully so.\u201D\",\"parentUIDs\":[1],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Dexter\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-1608.5,\"yPos\":-47},\"ID\":8,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"(Sighing):
    \u201CWant her gone? I wanted her back, more like. But I would never hurt her.
    I left her a love note in her makeup bag, just so she\u2019d know I was still
    there, still waiting.\u201D\",\"parentUIDs\":[5],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Dexter\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-1599.5,\"yPos\":106},\"ID\":9,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"(Bitterly):
    \u201CArgue? We argued all the time. She liked it when I got fired up\u2014said
    it made me look more \u2018alive.\u2019 But that lipstick smear on the wall in
    the smoking room? That\u2019s hers, from our last conversation. Go look.\u201D\",\"parentUIDs\":[6],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Dexter\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-1617.5,\"yPos\":263},\"ID\":10,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"(Darkly):
    \u201CIt was everything. She wanted to destroy me. But I was always there. Look
    for the wig cap I left behind\u2014it\u2019s got blood on it. But it\u2019s mine,
    not hers.\u201D\",\"parentUIDs\":[7],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Dexter\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":12},{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":13},{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":14}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":20.5,\"yPos\":482},\"ID\":11,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"\u201CJealous?
    No. Devastated? Yes. I didn\u2019t just lose her\u2014I lost everything.\u201D\",\"parentUIDs\":[2],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Dexter\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-413.5,\"yPos\":836},\"ID\":15,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"(Nods):
    \u201CI tried. But she was stubborn. So I left her a message in her favourite
    cigarette pack along with a lighter I found. It\u2019s still there if you want
    to see how desperate I was.\u201D\",\"parentUIDs\":[12],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Dexter\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-21.5,\"yPos\":837},\"ID\":16,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"(Grimacing):
    \u201CI just walked away. But Ginny was there. He heard everything. He might\u2019ve
    even seen me near the spotlight controls\u2014trying to calm myself. Check if
    my prints are still there.\u201D\",\"parentUIDs\":[13],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Dexter\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[],\"EditorInfo\":{\"isRoot\":false,\"xPos\":339.5,\"yPos\":829},\"ID\":17,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"(Sighs):
    \u201CNo\u2026 but I wanted closure. So I wrote her a goodbye message. Check
    her lipstick message in the smoking room\u2014it was our last conversation.\u201D\",\"parentUIDs\":[14],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Dexter\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":19},{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":20},{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":21}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":1002.5,\"yPos\":5},\"ID\":18,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"\u201COh,
    darling, I was right where I was supposed to be\u2014centre of attention. But
    people like to forget the details when it\u2019s convenient.\u201D\",\"parentUIDs\":[3],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Dexter\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[],\"EditorInfo\":{\"isRoot\":false,\"xPos\":1678.5,\"yPos\":-185},\"ID\":22,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"(Raising
    an Eyebrow): \u201CI did. Our little Fan-Atic was hanging around like a stray
    kitten, but she didn\u2019t look too pleased. Check the bouquet she left backstage\u2014it\u2019s
    more of a mess than she is.\u201D\",\"parentUIDs\":[19],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Dexter\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[],\"EditorInfo\":{\"isRoot\":false,\"xPos\":1685.5,\"yPos\":8},\"ID\":23,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"(Defensive):
    \u201CI was trying to make her look good, alright? Not that she needed it. But
    someone tampered with the spotlight right before her act. My prints are there,
    sure\u2014but I wasn\u2019t the last one to touch it. Someone should check that
    lighting schedule.\u201D\",\"parentUIDs\":[20],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Dexter\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[],\"EditorInfo\":{\"isRoot\":false,\"xPos\":1682.5,\"yPos\":183},\"ID\":24,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"(Scoffs):
    \u201CAlibi? Honey, I don\u2019t need an alibi. I\u2019m Dexter Delight. But
    ask Ginny\u2014he\u2019s always watching. Besides, someone left a cigarette pack
    with a note backstage. It\u2019s not mine, but I\u2019d bet anything it\u2019s
    Ginny\u2019s handiwork.\u201D\",\"parentUIDs\":[21],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Dexter\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0}]}"
