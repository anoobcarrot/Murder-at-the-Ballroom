  json: "{\"Options\":[{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":4}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-578.5,\"yPos\":30},\"ID\":1,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Option
    A:\\n\u201CYou must have been thrilled to be here tonight. See anything suspicious?\u201D\",\"parentUIDs\":[0],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":11}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-89.5,\"yPos\":271},\"ID\":2,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Option
    B:\\n\u201CHow did you feel when Madame Mirage fell?\u201D\",\"parentUIDs\":[0],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":18}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":367.5,\"yPos\":32},\"ID\":3,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Option
    C: \\n\u201CWere you backstage before the show?\u201D\",\"parentUIDs\":[0],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":8}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-1223.5,\"yPos\":-80},\"ID\":5,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Option
    A:\\n\u201CNormal drama? Like what?\u201D\",\"parentUIDs\":[4],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":9}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-1226.5,\"yPos\":50},\"ID\":6,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Option
    B:\\n\u201CWhat about Dexter? Did you see him?\u201D\",\"parentUIDs\":[4],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":10}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-1217.5,\"yPos\":200},\"ID\":7,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Option
    C:\\n\u201CAnyone else stand out to you tonight?\u201D\",\"parentUIDs\":[4],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":15}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-490.5,\"yPos\":543},\"ID\":12,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Option
    A:\\n\u201CDid you notice anything unusual about her performance?\u201D\",\"parentUIDs\":[11],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":16}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-115.5,\"yPos\":589},\"ID\":13,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Option
    B:\\n\u201CYou seemed really invested in her every move. Why?\u201D\",\"parentUIDs\":[11],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":17}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":192.5,\"yPos\":527},\"ID\":14,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Option
    C:\\n\u201CWere you close enough to hear anything she said?\u201D\",\"parentUIDs\":[11],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":22}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":1073.5,\"yPos\":-153},\"ID\":19,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Option
    A:\\n\u201CWhat did you see Susie do backstage?\u201D\",\"parentUIDs\":[18],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":23}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":1052.5,\"yPos\":28},\"ID\":20,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Option
    B: \\n\u201CWhat did you say to Madame Mirage before the show?\u201D\",\"parentUIDs\":[18],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":24}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":1064.5,\"yPos\":219},\"ID\":21,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Option
    C:\\n\u201CDid you see Ginny or Dexter backstage too?\u201D\",\"parentUIDs\":[18],\"SpeechUID\":-1}],\"Parameters\":[],\"SpeechNodes\":[{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":1},{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":2},{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":3}],\"EditorInfo\":{\"isRoot\":true,\"xPos\":-82,\"yPos\":22},\"ID\":0,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"\\\"Eeeeeee,
    I've waited my whole life to be asked about Madam Mirage!\\\"\",\"parentUIDs\":[],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Fan
    Atic\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":5},{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":6},{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":7}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-939.5,\"yPos\":16},\"ID\":4,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"\u201COh
    my gosh, yesss! It was the BEST night... until it wasn\u2019t. But I didn\u2019t
    see anything bad. Just... everyone\u2019s normal drama.\u201D\",\"parentUIDs\":[1],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Fan
    Atic\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-1492.5,\"yPos\":-108},\"ID\":8,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"(Giggling):
    \u201COh, you know. Like Susie arguing with Ginny. But I thought they were just
    being... you know, sisters. But Susie looked like she wanted to... I dunno, do
    something bad. Maybe ask another audience member fof insights? Everyone enjoys
    their fabulous drama.\",\"parentUIDs\":[5],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Fan
    Atic\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-1488.5,\"yPos\":48},\"ID\":9,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"(Shrugs):
    \u201CDexter was all over the place. He even dropped his wig cap near the stage.
    But nobody noticed, and he was gone before anyone could pick it up. Maybe he
    was hiding something.\u201D\",\"parentUIDs\":[6],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Fan
    Atic\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-1493.5,\"yPos\":197},\"ID\":10,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"(Nodding):
    \u201CYeah, Ginny seemed really... jumpy. And he left the bathroom in such a
    rush. You should check if there\u2019s anything left behind there.\u201D\",\"parentUIDs\":[7],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Fan
    Atic\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":12},{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":13},{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":14}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-86.5,\"yPos\":411},\"ID\":11,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"\u201CFeel?
    I... I felt... lost. Like someone took my whole world and just... crushed it.
    But maybe she wanted it that way\u2014wanted to go out in a blaze of glory.\u201D\",\"parentUIDs\":[2],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Fan
    Atic\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-556.5,\"yPos\":722},\"ID\":15,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"(Sighs):
    \u201CShe looked... like something was on her mind.  Maybe ask Big Daddy Blaze?
    Mirage would confine in him during pre show smoke breaks.\\\"\",\"parentUIDs\":[12],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Fan
    Atic\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-116.5,\"yPos\":734},\"ID\":16,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"(Eagerly):
    \u201COh, I am! I know everything about her\u2014every performance, every costume
    change, even her favourite makeup brand. Sometimes, when I watch closely enough,
    I can see what she\u2019s thinking. But tonight, she looked... worried. Check
    her makeup bag. It might be there\u2014something\u2019s off.\u201D\",\"parentUIDs\":[13],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Fan
    Atic\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[],\"EditorInfo\":{\"isRoot\":false,\"xPos\":236.5,\"yPos\":699},\"ID\":17,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"(Excitedly):
    \u201CI was! I was right by the front. She whispered something... but I couldn\u2019t
    catch it all. It was something about \u2018time running out\u2019 and... I think
    she said \u2018lighting.\u2019 Maybe check the control panel backstage?\u201D\",\"parentUIDs\":[14],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Fan
    Atic\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":19},{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":20},{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":21}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":797.5,\"yPos\":17},\"ID\":18,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"\u201CM-maybe...
    I mean, I was only there for a second! Just to wish her luck! But then... then
    Susie came over, and I left. I didn\u2019t want to get in her way.\u201D\",\"parentUIDs\":[3],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Fan
    Atic\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[],\"EditorInfo\":{\"isRoot\":false,\"xPos\":1374.5,\"yPos\":-172},\"ID\":22,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"(Hesitantly):
    \u201CShe was... near the lighting controls. I thought she was just fixing something,
    but she looked... sneaky. Maybe ask another participant - they might have seen
    more backstage?\_\",\"parentUIDs\":[19],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Fan
    Atic\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[],\"EditorInfo\":{\"isRoot\":false,\"xPos\":1360.5,\"yPos\":12},\"ID\":23,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"(Sighs):
    \u201CI\u2014I wished her luck. Told her I\u2019d always be her biggest fan,
    no matter what. But she just... brushed me off. Said I should... \u2018step back
    and let the real stars shine.\u2019 So, I left her the bouquet. Maybe it\u2019s
    still there. Maybe you\u2019ll find something I missed.\u201D\\n\",\"parentUIDs\":[20],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Fan
    Atic\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[],\"EditorInfo\":{\"isRoot\":false,\"xPos\":1377.5,\"yPos\":193},\"ID\":24,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"(Nods):
    \u201CI did! Dexter was arguing with Madame by the dressing room door, but he
    stormed off before I could get close. Ginny... well, he just looked lost. He
    kept staring at the lipstick on the mirror. I thought it was just nerves, but
    now... who knows?\u201D\",\"parentUIDs\":[21],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Fan
    Atic\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0}]}"
